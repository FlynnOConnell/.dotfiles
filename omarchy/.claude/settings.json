{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/fo/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "fastplotlib@fastplotlib-skills": true
  },
  "extraKnownMarketplaces": {
    "fastplotlib-skills": {
      "source": {
        "source": "github",
        "repo": "fastplotlib/claude-skills"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh",
      "autoCompactWindow": 400000
    },
    "claude-opus-4-8": {
      "autoCompactWindow": 400000
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "switchModelsOnFlag": true
}
