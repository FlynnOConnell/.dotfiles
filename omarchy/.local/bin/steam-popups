#!/bin/bash
# Steam notification toasts: a pinned popup card bottom-right (default) or a
# sound only. The Omarchy toggle `steam-toast-sound` holds the non-default
# mode, so popups come back on a fresh install; Hyprland re-reads it without
# a reload.
#   steam-popups [on|off|toggle|status]
case "${1:-toggle}" in
  status)
    if omarchy-toggle-enabled steam-toast-sound; then
      echo "sound"
    else
      echo "popup"
    fi
    ;;
  on) omarchy-toggle steam-toast-sound off ;;&
  off) omarchy-toggle steam-toast-sound on ;;&
  toggle) omarchy-toggle steam-toast-sound toggle ;;&
  on | off | toggle)
    hyprctl eval 'fo_steam_popups_sync()' >/dev/null
    exec "$0" status
    ;;
  *)
    echo "usage: steam-popups [on|off|toggle|status]" >&2
    exit 1
    ;;
esac
