#!/usr/bin/env bash
# Quick note (SUPER+SHIFT+W, a pop-over in hyprland.lua): opens today's inbox
# note in Obsidian. Notes go in the vault repo
# (~/repos/arctic-lake/private/inbox/<date>.md), one file per day with a
# timestamp heading per visit. Hiding the pop-over runs repo-sync, which
# commits and pushes; the repo-sync timer covers anything else (edits made
# elsewhere in the vault, other machines).

set -euo pipefail

dir=~/repos/arctic-lake/private/inbox
note=$dir/$(date +%F).md
mkdir -p "$dir"

if [[ ! -s $note ]]; then
  printf '# %s\n' "$(date '+%A %-d %B %Y')" >"$note"
fi
printf '\n## %s\n\n' "$(date +%H:%M)" >>"$note"

# Obsidian is single-instance: a running one just switches to the file.
setsid -f uwsm-app -- obsidian "obsidian://open?path=$note" >/dev/null 2>&1
