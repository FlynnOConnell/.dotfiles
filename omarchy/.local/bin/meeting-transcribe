#!/home/fo/envs/transcribe/.venv/bin/python
"""
Transcribe a meeting recorded by meeting-record into one speaker-labelled markdown file.

    meeting-transcribe [STEM]

STEM is the shared prefix of the pair in ~/meetings (e.g. 2026-10-30-1721); the
newest pair when omitted. Writes ~/meetings/<STEM>.md and prints its path.
"""

import argparse
import ctypes
import datetime
import os
import sys
import wave
from pathlib import Path

import numpy as np

## NOTE: with the xet transport the hub twice wrote a truncated model.bin and reported
## success (2026-10-27, 2026-10-30); the plain HTTP download is fine.
os.environ.setdefault("HF_HUB_DISABLE_XET", "1")

## NOTE: CUDA lives only in the env's nvidia-* wheels, which ctranslate2 does not look in;
## preload them (cublasLt before cublas) so its dlopen finds them already resident.
DIR_NVIDIA = Path(np.__file__).parents[1] / "nvidia"
for name in ("cublas/lib/libcublasLt.so.12", "cublas/lib/libcublas.so.12", "cuda_nvrtc/lib/libnvrtc.so.12", "cudnn/lib/libcudnn.so.9"):
    ctypes.CDLL(str(DIR_NVIDIA / name), mode=ctypes.RTLD_GLOBAL)

import faster_whisper


DIR_MEETINGS = Path.home() / "meetings"
MODEL = "large-v3-turbo"
SPEAKERS = {"me": "me", "them": "them"}


def find_latest_stem(dir_meetings: Path) -> str:
    """Stem of the newest *-me.wav in the meetings directory."""
    filepaths_me = sorted(dir_meetings.glob("*-me.wav"), key=lambda p: p.stat().st_mtime)
    if not filepaths_me:
        raise SystemExit(f"no *-me.wav in {dir_meetings}")
    return filepaths_me[-1].name[: -len("-me.wav")]


def read_wav_16k_mono(filepath_wav: str) -> np.ndarray:
    """Samples of a 16 kHz mono 16-bit wav as float32 in [-1, 1], the form whisper takes directly."""
    with wave.open(filepath_wav, "rb") as wav:
        if (wav.getframerate(), wav.getnchannels(), wav.getsampwidth()) != (16000, 1, 2):
            raise ValueError(f"{filepath_wav}: expected 16 kHz mono 16-bit, as meeting-record writes")
        frames = wav.readframes(wav.getnframes())
    return np.frombuffer(frames, dtype=np.int16).astype(np.float32) / 32768.0


def transcribe_file(model: faster_whisper.WhisperModel, filepath_wav: str, speaker: str) -> list:
    """
    Segments of one recording as (start_s, end_s, speaker, text).

    VAD drops the long silences a one-sided recording is mostly made of, which
    also stops whisper hallucinating text into them. The wav is decoded here
    because faster-whisper's own decoder needs an older PyAV than the env has.
    """
    segments, info = model.transcribe(
        read_wav_16k_mono(filepath_wav),
        language="en",
        beam_size=5,
        vad_filter=True,
        vad_parameters={"min_silence_duration_ms": 700},
        condition_on_previous_text=False,
    )
    rows = []
    for segment in segments:
        text = segment.text.strip()
        if text:
            rows.append((segment.start, segment.end, speaker, text))
        print(f"\r{speaker}: {segment.end / info.duration:6.1%}", end="", file=sys.stderr, flush=True)
    print(file=sys.stderr)
    return rows


def merge_turns(rows: list, gap_s: float = 2.0) -> list:
    """Sort by time and join consecutive segments of one speaker into a turn when they are close."""
    turns = []
    for start, end, speaker, text in sorted(rows):
        if turns and turns[-1][2] == speaker and start - turns[-1][1] < gap_s:
            turns[-1] = (turns[-1][0], end, speaker, turns[-1][3] + " " + text)
        else:
            turns.append((start, end, speaker, text))
    return turns


def format_timestamp(seconds: float) -> str:
    return str(datetime.timedelta(seconds=int(seconds)))


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("stem", nargs="?", help="shared prefix of the -me.wav / -them.wav pair")
    args = parser.parse_args()
    stem = args.stem or find_latest_stem(DIR_MEETINGS)

    filepaths = {speaker: DIR_MEETINGS / f"{stem}-{suffix}.wav" for speaker, suffix in SPEAKERS.items()}
    for filepath in filepaths.values():
        if not filepath.exists():
            raise SystemExit(f"missing {filepath}")

    model = faster_whisper.WhisperModel(MODEL, device="cuda", compute_type="float16")
    rows = []
    for speaker, filepath in filepaths.items():
        rows += transcribe_file(model=model, filepath_wav=str(filepath), speaker=speaker)

    filepath_md = DIR_MEETINGS / f"{stem}.md"
    lines = [f"# Meeting {stem}", "", f"Transcribed with faster-whisper {MODEL}; `me` is the mic, `them` is the speaker output.", ""]
    for start, _end, speaker, text in merge_turns(rows):
        lines.append(f"**[{format_timestamp(start)}] {speaker}:** {text}")
        lines.append("")
    filepath_md.write_text("\n".join(lines))
    print(filepath_md)


if __name__ == "__main__":
    main()
