#!/usr/bin/env bash
# Keep this machine's notes and dotfiles in step with GitHub, so every omarchy
# machine (home, pml-w1, pml-w2, ...) has the same notes and config while it's
# running. Runs from repo-sync.timer every 5 minutes and from quick-note when
# its window closes.
#
# Notes (~/repos/arctic-lake, the private vault; lab notes and the quick-note
# inbox live under private/): everything not gitignored is committed,
# remote changes are rebased in, and the result is pushed. A conflict aborts
# the rebase, keeps the local commit, and sends a notification; nothing is
# lost, it just needs a hand.
#
# Dotfiles (~/repos/.dotfiles): never committed automatically. Local commits
# are pushed, and remote commits are fast-forwarded in, after which
# install-omarchy.sh --link picks up new files and services and Hyprland
# reloads. Nothing is pulled while tracked files have uncommitted edits: the
# repo's files are the live config, so a botched merge would be a broken
# config. A branch that has diverged is likewise left alone for a manual
# rebase; the journal says so.
#
# GitHub is reached with the machine's own key file, not the 1Password agent:
# a locked agent fails every fetch, and the machine would quietly stop syncing
# until someone unlocked it. No network: git gives up instead of waiting for a
# prompt, the journal says so, and the next run tries again.

set -u

key=~/.ssh/id_ed25519
if [[ -r $key ]]; then
  export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=15 -o IdentityAgent=none -o IdentitiesOnly=yes -i $key"
else
  export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=15"
fi
git() { command timeout 60 git "$@"; }

notes=(~/repos/arctic-lake)
dotfiles=~/repos/.dotfiles
status=0

sync_notes() {
  cd "$1" || return 1
  exec 9>.git/repo-sync.lock
  flock -w 60 9 || return 0

  git add -A
  if ! git diff --cached --quiet; then
    git commit -q -m "notes: $(date '+%Y-%m-%d %H:%M') on $(uname -n)"
  fi

  git fetch -q 2>/dev/null || { echo "${1##*/}: can't reach GitHub, the commit waits for the next run" >&2; return 0; }
  if ! git rebase -q '@{u}' 2>/dev/null; then
    git rebase --abort 2>/dev/null
    notify-send -u critical "Notes sync: conflict in ${1##*/}" \
      "Local commit kept. Resolve with: cd $1 && git pull --rebase"
    return 1
  fi
  git push -q 2>/dev/null || true
}

sync_dotfiles() {
  cd "$1" || return 1
  exec 8>.git/repo-sync.lock
  flock -w 60 8 || return 0

  git fetch -q 2>/dev/null || { echo "dotfiles: can't reach GitHub" >&2; return 0; }
  local head upstream
  head=$(git rev-parse HEAD)
  upstream=$(git rev-parse '@{u}' 2>/dev/null) || return 0
  [[ $head == "$upstream" ]] && return 0

  if git merge-base --is-ancestor "$upstream" "$head"; then
    git push -q 2>/dev/null || true # local commits, nothing new upstream
  elif git merge-base --is-ancestor "$head" "$upstream"; then
    if ! git diff --quiet HEAD; then
      # install-omarchy.sh adopts live edits into tracked files, so this is
      # routine; say so once per new upstream commit, not every 5 minutes.
      local msg="Commit or stash the local edits in ~/repos/.dotfiles so it can fast-forward"
      echo "dotfiles: behind origin but tracked files have local edits. $msg" >&2
      if [[ $(cat .git/repo-sync.notified 2>/dev/null) != "$upstream" ]]; then
        echo "$upstream" >.git/repo-sync.notified
        notify-send "Dotfiles: new commits on GitHub not pulled" "$msg"
      fi
      return 1
    fi
    git merge -q --ff-only '@{u}' 2>/dev/null || return 1
    "$1/install-omarchy.sh" --link >/dev/null || echo "dotfiles: install-omarchy.sh --link failed" >&2
    # from the timer there's no HYPRLAND_INSTANCE_SIGNATURE; the newest socket dir is this session's
    local sig
    sig=$(ls -t "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr" 2>/dev/null | head -1)
    [[ -n $sig ]] && HYPRLAND_INSTANCE_SIGNATURE=$sig hyprctl reload >/dev/null 2>&1
  else
    echo "dotfiles: diverged from origin, rebase it by hand: cd $1 && git pull --rebase" >&2
    return 1
  fi
}

for repo in "${notes[@]}"; do
  [[ -d $repo/.git ]] && { (sync_notes "$repo") || status=1; }
done
[[ -d $dotfiles/.git ]] && { (sync_dotfiles "$dotfiles") || status=1; }

exit $status
