#!/bin/bash
#
echo "Sourcing aliases..."
#
alias VIM="nvim"
alias mysudo='sudo -E env "PATH=$PATH"'

# - Remote ----
cdm() { cd /mnt/c/Users/$USER ; }

alias vgpu='remmina ~/.local/share/remmina/rockefellernt_rdp_v-gpu2_129-85-3-29.remmina &'
alias rdp='remmina ~/.local/share/remmina/rockefellernt_rdp_v-gpu2_129-85-3-29.remmina &'

# - Copy ----
alias cpw='xsel --clipboard < ~/.password.txt'
alias cppy='xsel --clipboard < ~/.password_pypi.txt'

# - Navigation -
alias lsa='ls -la'
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias ~="cd ~"
alias cdaw="cd ~/.config/awesome"
alias cdr="cd ~/repos"
alias cdd="cd ~/repos/.dotfiles"
alias cdot="cd ~/repos/.dotfiles/dots"
alias cdt="cd ~/.config/tmux"
alias cdn="cd ~/.config/nvim/"

# - Nvim To File ----
alias goa="nvim ~/.aliases"

alias gol="nvim ~/.config/lazygit/config.yml"
alias gols="nvim ~/.config/lazygit/state.yml"
alias goz="nvim ~/.zshrc"
alias gov="nvim ~/.vimrc"
alias goi='nvim ~/.ideavimrc'
alias got="nvim ~/repos/.dotfiles/dots/.config/tmux/tmux.conf"
alias gos="nvim ~/repos/.dotfiles/scripts/install_essentials"
alias gok="nvim ~/repos/.dotfiles/dots/.config/kitty/kitty.conf"
alias god="nvim ~/repos/.dotfiles/"
alias goi3="nvim ~/.config/i3/config"
alias gon="nvim ~/.config/nvim/"
alias goicon='nvim ~/.icons/'
alias goaw="nvim ~/.config/awesome/"

# - Source --------
alias sz="source ~/.zshrc"
alias st="tmux source ~/.config/tmux/tmux.conf"

# - Git ---------
alias gs="git status"
alias ga="git add"
alias gb="git branch"
alias gc="git commit"

# - Tools ---------
alias hf="history | fzf -e"
alias lg="CONFIG_DIR="$HOME/.config/lazygit" /usr/local/bin/lazygit"

# - Helpers ---------
alias cs='cheatsheet'
alias key='cat ~/repos/.dotfiles/scripts/shortcuts.txt'
alias keys='cat ~/repos/.dotfiles/scripts/shortcuts.txt'
alias path='tr ":" "\n" <<< "$PATH"'
alias logout='sudo service gdm restart'

# - Python / Conda
alias mm='micromamba'

navialias() {
    navi --query ":: $1" --best-match
}

alias ng="navialias git"
alias n="nvim -c 'Telescope oldfiles'"
alias e='fzf -m --bind ctrl-a:select-all,ctrl-d:deselect-all,ctrl-t:toggle-all --print0 --preview "bat --theme catppuccin --color=always {}" | xargs -0 -o $EDITOR'

# tmux quick session
alias td="tms ~/repos/.dotfiles/"

alias pkp="sudo pkill -9 pulsesecure && pkill -9 pulseUI"

# - Windows Apps (WSL) --------
alias firefox='/mnt/c/Program Files/Firefox Developer Edition/firefox.exe'

# - Komorebi (Windows) --------
# Start/Restart komorebi with all configurations
alias kstart='powershell.exe -ExecutionPolicy Bypass -File "C:\\Users\\flynn\\start-komorebi.ps1"'
alias krestart='powershell.exe -ExecutionPolicy Bypass -File "C:\\Users\\flynn\\start-komorebi.ps1"'

# Stop komorebi
alias kstop='powershell.exe -Command "Get-Process | Where-Object { \$_.Name -match '"'"'komorebi|whkd'"'"' } | Stop-Process -Force"'

# Check komorebi status
alias kstatus='powershell.exe -Command "Get-Process | Where-Object { \$_.Name -match '"'"'komorebi|whkd'"'"' } | Format-Table Name, Id, CPU -AutoSize"'

# Quick gaps configuration (without full restart)
kgaps() {
    local gap_size=${1:-10}
    echo "Setting gaps to ${gap_size}px for all workspaces..."
    powershell.exe -Command "for (\$m = 0; \$m -lt 2; \$m++) { for (\$w = 0; \$w -lt 10; \$w++) { komorebic.exe workspace-padding \$m \$w $gap_size 2>\$null; komorebic.exe container-padding \$m \$w $gap_size 2>\$null } }; Write-Host 'Gaps set to ${gap_size}px' -ForegroundColor Green"
}

# Edit komorebi startup script
alias gokstart='nvim /mnt/c/Users/flynn/start-komorebi.ps1'

# Komorebi state (JSON output)
alias kstate='powershell.exe -Command "komorebic.exe state"'

# Reload komorebi config
alias kreload='powershell.exe -Command "komorebic.exe reload-configuration"'

# - Network Drives (MBO) --------
# Passwordless sudo: /etc/sudoers.d/network-drives
alias mnt='mountpoint -q /mnt/s1_data || sudo mount /mnt/s1_data; mountpoint -q /mnt/mbospace || sudo mount /mnt/mbospace; mntstatus'
alias umnt='sudo umount /mnt/s1_data 2>/dev/null; sudo umount /mnt/mbospace 2>/dev/null; echo "Unmounted drives"'
alias mntstatus='echo "" && echo "  Network Drive Status" && echo "  =====================" && for d in s1_data mbospace; do mountpoint -q /mnt/$d && echo -e "  \033[32m●\033[0m /mnt/$d (mounted)" || echo -e "  \033[31m○\033[0m /mnt/$d (not mounted)"; done && echo ""'

# Notes (vault: ~/repos/docs)
alias cdnotes='cd ~/repos/docs/notes'

# on - open notes (fzf browser)
function on {
  local vault=~/repos/docs
  if command -v fzf &>/dev/null; then
    local selected=$(find "$vault" -name "*.md" -type f | sed "s|$vault/||" | fzf --prompt="Note: " --height=40% --reverse)
    [[ -n "$selected" ]] && nvim "$vault/$selected"
  else
    nvim "$vault/notes"
  fi
}

# od - open daily note with template
function od {
  local vault=~/repos/docs
  local today=$(date +%Y-%m-%d)
  local file="$vault/daily/$today.md"
  mkdir -p "$vault/daily"
  if [[ ! -f "$file" ]]; then
    local template="$vault/templates/daily.md"
    if [[ -f "$template" ]]; then
      sed "s/{{date}}/$today/g" "$template" > "$file"
    fi
  fi
  nvim "$file"
}

# ow - open weekly note with template
function ow {
  local vault=~/repos/docs
  local week_num=$(date +%V)
  local year=$(date +%Y)
  local file="$vault/weekly/$year-W$week_num.md"
  mkdir -p "$vault/weekly"
  if [[ ! -f "$file" ]]; then
    local template="$vault/templates/weekly.md"
    if [[ -f "$template" ]]; then
      local dow=$(date +%u)
      local mon=$(date -d "today - $((dow - 1)) days" +%s)
      local fri=$(date -d "@$mon + 4 days" +%s)

      local date_short=$(date +%Y-%m-%d)
      local mon_date=$(date -d "@$mon" "+%B %d")
      local fri_date=$(date -d "@$fri" "+%B %d, %Y")
      local prev_week="$year-W$(printf '%02d' $((10#$week_num - 1)))"
      local next_week="$year-W$(printf '%02d' $((10#$week_num + 1)))"

      sed -e "s/<% tp\.date\.now(\"YYYY-MM-DD\") %>/$date_short/g" \
          -e "s/<% tp\.date\.now(\"MMMM DD\") %>/$mon_date/g" \
          -e "s/<% tp\.date\.now(\"MMMM DD, YYYY\", 6) %>/$fri_date/g" \
          -e "s/<% tp\.date\.now(\"YYYY-\[W\]WW\", -7) %>/$prev_week/g" \
          -e "s/<% tp\.date\.now(\"YYYY-\[W\]WW\", 7) %>/$next_week/g" \
          -e "s/{{date}}/$date_short/g" \
          -e "s/{{week_range}}/$mon_date - $fri_date/g" \
          "$template" > "$file"
    fi
  fi
  nvim "$file"
}
