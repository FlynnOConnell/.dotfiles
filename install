#!/usr/bin/env bash
# omarchy desktop -> install-omarchy.sh; servers use install-server.sh, windows install.ps1.

set -e

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if command -v omarchy >/dev/null; then
  exec "$BASEDIR/install-omarchy.sh" "$@"
fi

echo "not an omarchy machine. use one of:" >&2
echo "  ./install-server.sh        headless linux / hpc" >&2
echo "  ./install.ps1              windows" >&2
echo "  legacy/install-i3.conf.yaml  old i3 desktop (archived, paths not updated)" >&2
exit 1
